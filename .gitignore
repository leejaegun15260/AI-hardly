# 인증키는 절대 저장소에 올리지 않습니다
.env
*.key
config/secrets.json

# 탐색 결과(원본 응답)에는 개인정보가 없지만 용량이 커서 제외합니다
data/raw/probe/

# 파이썬
__pycache__/
*.pyc
.venv/
venv/

# 수집한 원본 창고 (137만 건, 용량이 커서 저장소에 올리지 않습니다)
data/build/jiwon.sqlite

# 사람이 읽기 쉬운 색인 두 개 (합쳐 36MB) — 용량이 커서 저장소에 올리지 않습니다.
#   같은 내용이 data/build/web_index.json 에 부피를 줄여 들어 있고, 화면도 그것을 읽습니다.
#   다시 만들려면:  python3 scripts/collect_jiwon.py --rebuild   (jiwon.sqlite 이 있을 때)
#                   jiwon.sqlite 이 없으면 python3 scripts/collect_jiwon.py 로 다시 받으면 됩니다.
data/build/major_index.json
data/build/cert_index.json
